{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Framework Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceDigest", "gitHeadAtGeneration", "codexVersion", "corpus", "gateEvidence", "skillCorpusAttestation", "skillCorpusProvenance", "artifactPolicy"],
  "properties": {
    "schemaVersion": {"const": 4},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "gitHeadAtGeneration": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "codexVersion": {"type": "string", "minLength": 1},
    "artifactPolicy": {"const": "incremental-commit-bound-attestation-v2"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "skillMainLines", "skillDescriptionCharacters", "largestSkillBytes", "references", "versionResolvers"],
      "properties": {
        "skills": {"type": "integer", "minimum": 1},
        "skillMainLines": {"type": "integer", "minimum": 1},
        "skillDescriptionCharacters": {"type": "integer", "minimum": 1},
        "largestSkillBytes": {"type": "integer", "minimum": 1},
        "references": {"type": "integer", "minimum": 0},
        "versionResolvers": {"type": "integer", "minimum": 1}
      }
    },
    "gateEvidence": {
      "description": "nativeDeliveryBehavior records a compact source/runtime-bound receipt issued only after raw native sessions and collector state are validated; per-case artifact hashes preserve that evidence integrity.",
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "exitCode", "output", "outputSha256"],
        "properties": {
          "name": {"enum": ["deterministicHealth", "tokenEfficiency", "effectiveInstallDoctor", "nativeSkillLoaderCanary", "liveVersionResolution", "nativeCapabilityCurrency", "nativeDeliveryBehavior", "skillCorpusCertification"]},
          "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "exitCode": {"const": 0},
          "output": {"type": "string", "minLength": 1},
          "outputSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "skillCorpusAttestation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "skillSha256", "contractSha256", "routingDigest", "semanticDigest", "rawEvidenceDigest", "model", "reasoningEffort", "codexVersion", "caseCount", "verdict"],
        "properties": {
          "skill": {"type": "string", "minLength": 1},
          "skillSha256": {"$ref": "#/$defs/sha256"},
          "contractSha256": {"$ref": "#/$defs/sha256"},
          "routingDigest": {"$ref": "#/$defs/sha256"},
          "semanticDigest": {"$ref": "#/$defs/sha256"},
          "rawEvidenceDigest": {"$ref": "#/$defs/sha256"},
          "model": {"type": "string", "minLength": 1},
          "reasoningEffort": {"type": "string", "minLength": 1},
          "codexVersion": {"type": "string", "minLength": 1},
          "caseCount": {"type": "integer", "minimum": 1},
          "verdict": {"const": "pass"}
        }
      }
    },
    "skillCorpusProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineEvidenceCommit", "baselineEvidenceSha256", "baselineSourceCommit", "freshSkills", "reusedSkills"],
      "properties": {
        "baselineEvidenceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "baselineEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "baselineSourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "freshSkills": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reusedSkills": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$"}
  }
}
