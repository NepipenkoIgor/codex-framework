{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Native Capability Review Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "codexVersion", "latestReleaseTag", "changelogReviewedThrough", "sources", "capabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "codexVersion": {"type": "string", "minLength": 1},
    "latestReleaseTag": {"type": "string", "pattern": "^rust-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "changelogReviewedThrough": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "sha256"],
        "properties": {
          "kind": {"enum": ["manual", "changelog", "release"]},
          "url": {"type": "string", "format": "uri"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nativeFeature", "decision", "localOverlap", "action", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "nativeFeature": {"type": "string", "minLength": 1},
          "decision": {"enum": ["adopted", "replaced", "removed", "retained", "permission-gated"]},
          "localOverlap": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
