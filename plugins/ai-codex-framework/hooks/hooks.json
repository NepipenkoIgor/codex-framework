{
  "description": "Deterministic shell safety checks for AI Codex Framework.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/pre-tool-use.sh\"",
            "timeout": 5,
            "statusMessage": "Checking safety policy"
          }
        ]
      }
    ]
  }
}
